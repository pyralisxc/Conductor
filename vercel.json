{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/internal/vcr-retention",
      "schedule": "*/5 * * * *"
    }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|preview) exit 1 ;; *) exit 0 ;; esac"
}
