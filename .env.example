PORT=3000
CONDUCTOR_PUBLIC_URL=https://conductor.example.com
CONDUCTOR_OWNER_PASSWORD=replace-with-a-strong-owner-password
CONDUCTOR_SESSION_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
# Dedicated provider-credential vault key. Configure before retiring/rotating the owner-session secret.
# CONDUCTOR_PROVIDER_CREDENTIAL_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
# During vault-key rotation, list old keys temporarily so successful reads can migrate records to the current key.
# CONDUCTOR_PROVIDER_CREDENTIAL_PREVIOUS_KEYS_JSON=["previous-random-secret-of-at-least-32-characters"]
CONDUCTOR_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
# CONDUCTOR_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# CONDUCTOR_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# CONDUCTOR_OAUTH_ALLOW_LOOPBACK=1
# Horizontally scaled hosts require shared, single-use authorization-code state.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# CONDUCTOR_REQUIRE_SHARED_OAUTH_STATE=1
CONDUCTOR_GITHUB_ALLOWED_OWNERS=pyralisxc
CONDUCTOR_PROJECTS_JSON=[{"id":"conductor","repository":"pyralisxc/Conductor","workspace":"/workspace/conductor"},{"id":"Development-Intelligence","repository":"pyralisxc/Development-Intelligence","vercelProject":"development-intelligence"}]
GITHUB_TOKEN=
DEVINT_MCP_URL=https://devint.example.com/mcp
DEVINT_AGENT_TOKEN=
# Optional server-side Vercel token fallback; prefer the owner-connected installation.
# CONDUCTOR_VERCEL_TOKEN=
# Optional exact runtime-log opt-in; must match an existing Vercel binding and contains no secrets.
# CONDUCTOR_VERCEL_RUNTIME_LOG_BINDINGS_JSON=[{"id":"conductor","repository":"pyralisxc/Conductor","vercelProject":"prj_...","vercelTeamId":"team_..."}]
# Bind each Vercel project with vercelProject, vercelConnectionId, and vercelTeamId.
# Write tools require this flag, an authorized client/work scope, and durable Redis state.
# CONDUCTOR_ENABLE_GITHUB_MUTATIONS=1

# ASC delegated-authority canary. Leave disabled until ASC Preview is configured and proven.
# CONDUCTOR_ENABLE_ASC_AUTHORITY_CANARY=1
# Public HTTPS ASC origin used only for server-to-server delegation consumption.
# CONDUCTOR_ASC_CONTROL_URL=https://asc.example.com
# Shared high-entropy ASC <-> Conductor service credential.
# CONDUCTOR_ASC_BRIDGE_SECRET=
