PORT=3000
CONDUCTOR_PUBLIC_URL=https://conductor.example.com
CONDUCTOR_OWNER_PASSWORD=replace-with-a-strong-owner-password
CONDUCTOR_SESSION_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
CONDUCTOR_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
# CONDUCTOR_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# CONDUCTOR_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# CONDUCTOR_OAUTH_ALLOW_LOOPBACK=1
# Horizontally scaled hosts require shared, single-use authorization-code state.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# CONDUCTOR_REQUIRE_SHARED_OAUTH_STATE=1
CONDUCTOR_GITHUB_ALLOWED_OWNERS=pyralisxc
CONDUCTOR_PROJECTS_JSON=[{"id":"conductor","repository":"pyralisxc/Conductor","workspace":"/workspace/conductor"},{"id":"Development-Intelligence","repository":"pyralisxc/Development-Intelligence","vercelProject":"development-intelligence"}]
GITHUB_TOKEN=
DEVINT_MCP_URL=https://devint.example.com/mcp
DEVINT_AGENT_TOKEN=
# Optional read-only Vercel deployment provider. Keep this token server-side.
# CONDUCTOR_VERCEL_TOKEN=
# Add "vercelProject" and optional "vercelTeamId" to a CONDUCTOR_PROJECTS_JSON binding.
# Mutations stay absent unless explicitly enabled; Redis is mandatory when enabled.
# CONDUCTOR_ENABLE_GITHUB_MUTATIONS=1
